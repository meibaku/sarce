{
  "name": "sarce",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "description": "Chess style analysis \u2014 track how your games match your preferred playing style",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=apps/web",
    "build:web": "npm run build --workspace=apps/web",
    "dev:api": "cd apps/api && uvicorn app.main:app --reload --port 8000",
    "test:api": "cd apps/api && pytest tests -v -m \"not stockfish\"",
    "test:golden": "cd apps/api && pytest tests/test_golden_analysis.py -m stockfish -v",
    "test:arch": "cd apps/api && pytest tests/test_architecture.py tests/test_philosophy_contracts.py -v",
    "lint:web": "npm run lint --workspace=apps/web",
    "scan:secrets": "node scripts/ci/secret-scan.mjs",
    "ci:security": "npm run scan:secrets && npm audit --audit-level=critical",
    "ci": "npm run scan:secrets && npm run test:api && npm run lint:web && npm run build:web",
    "pr:create": "node scripts/gh-pr-staging.mjs",
    "pr:promote": "node scripts/gh-pr-promote.mjs",
    "pilot:admit": "node scripts/release/validate-pilot-readiness.mjs docs/evidence/style-pilot-readiness.json",
    "pilot:runtime-check": "cd apps/api && python scripts/pilot_runtime_check.py",
    "pilot:smoke": "cd apps/api && python scripts/pilot_smoke.py"
  }
}
