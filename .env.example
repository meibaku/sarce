# Supabase local (run: supabase start && supabase status)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-local-anon-key
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key

# FastAPI backend
API_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=/api/backend

# Multi-user: require a Supabase sign-in on every API request (default: local-first, no sign-in)
AUTH_REQUIRED=false
# Durable per-user analysis queue (apply the analysis_jobs migration first). Off = BackgroundTasks.
JOB_QUEUE_ENABLED=false

# Local-first dev user (matches supabase/seed.sql)
LOCAL_USER_ID=00000000-0000-4000-8000-000000000001
NEXT_PUBLIC_LOCAL_USER_ID=00000000-0000-4000-8000-000000000001

# Stockfish — folder or full path to .exe. A folder with several release builds uses the fastest
# one this CPU runs (avx512 > avxvnni > avx2 > bmi2 > ...), checked once at startup.
STOCKFISH_PATH=C:\Users\user\Documents\stockfish
ANALYSIS_DEPTH=18
# Games analysed at once, one single-threaded engine each. 0 = one per CPU core, leaving one free.
ANALYSIS_WORKERS=0
# Chaos Lens raw data (docs/CHAOS_PLAN.md, M1) — apply the position_evals migration first.
# When true, each analysed game also gets node-limited MultiPV evals for every ply, and Phase 1
# reads those same searches instead of running its own.
POSITION_EVALS_ENABLED=false
# Intention tagger (M7) — apply the intention_tags migration first. Engine-free and fast.
IDEA_TAGGER_ENABLED=false
# Human move model: auto (default — Maia-2 if installed, else the heuristic), maia2, or heuristic.
# Maia-2 is optional: pip install -r apps/api/requirements-maia.txt
HUMAN_MODEL=auto
ANALYSIS_NODES=1500000

# Brilliant detection thresholds (tunable)
BRILLIANT_EVAL_MARGIN=0.3
BRILLIANT_WINNING_MARGIN=3.0

# Chess.com API (public, no key required)
CHESS_COM_API_BASE=https://api.chess.com/pub
