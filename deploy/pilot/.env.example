AUTH_REQUIRED=true
PILOT_MODE=style_v1
PILOT_PROTOCOL_VERSION=style-v1
PILOT_PRIVACY_VERSION=pilot-privacy-v1
PILOT_OPERATORS=["replace-with-supabase-user-id"]
MONITOR_OPERATORS=["replace-with-supabase-user-id"]
JOB_QUEUE_ENABLED=true
AUTO_SYNC_ENABLED=false
HUMAN_MODEL=maia2
POSITION_EVALS_ENABLED=false
STOCKFISH_PATH=/usr/local/bin/stockfish
ANALYSIS_NODES=1500000
ANALYSIS_WORKERS=2
PILOT_BACKUP_RETENTION_DAYS=30
PILOT_ARTIFACT_SHA=
PILOT_IMAGE_DIGEST=
PILOT_IMAGE_REF=
PILOT_RUNTIME_MANIFEST_PATH=/opt/sarce/runtime-manifest.json
CORS_ORIGINS=["https://replace-with-pilot-domain"]
SUPABASE_URL=https://replace.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
STOCKFISH_DOWNLOAD_URL=https://github.com/official-stockfish/Stockfish/releases/download/sf_19/stockfish-linux-x86-64-universal.tar.gz
